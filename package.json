{
  "name": "dsh-rider-bridge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "从 Rider 打开工程和文件上下文到 DSH 新草稿。",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/RookieLouis/dsh-rider-bridge.git" },
  "homepage": "https://github.com/RookieLouis/dsh-rider-bridge#readme",
  "bugs": { "url": "https://github.com/RookieLouis/dsh-rider-bridge/issues" },
  "main": "./lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "src", "tools", "tests", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": { "build": "node tools/build-client.mjs", "test": "node --test tests/*.test.mjs" },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web", "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-gateway", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
